{
  "id": "hq-video",
  "name": "HQ Video (Wan 2.2 TI2V-5B)",
  "kind": "video",
  "description": "Text-to-video on Wan 2.2 TI2V-5B. Real temporal model with server-side encoding — no FFmpeg required. Requires the three Wan 2.2 model files (see requires).",
  "defaults": {
    "width": 1280,
    "height": 704,
    "steps": 20,
    "cfg_scale": 5.0,
    "fps": 24,
    "duration_seconds": 2
  },
  "requires": {
    "note": "Derived verbatim from the official ComfyUI template 'video_wan2_2_5B_ti2v'. Wan 2.2 is Apache-2.0 — commercial use permitted.",
    "models": [
      {
        "input": "unet_name",
        "file": "wan2.2_ti2v_5B_fp16.safetensors",
        "folder": "diffusion_models",
        "url": "https://huggingface.co/Comfy-Org/Wan_2.2_ComfyUI_Repackaged/resolve/main/split_files/diffusion_models/wan2.2_ti2v_5B_fp16.safetensors"
      },
      {
        "input": "clip_name",
        "file": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "folder": "text_encoders",
        "url": "https://huggingface.co/Comfy-Org/Wan_2.1_ComfyUI_repackaged/resolve/main/split_files/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors"
      },
      {
        "input": "vae_name",
        "file": "wan2.2_vae.safetensors",
        "folder": "vae",
        "url": "https://huggingface.co/Comfy-Org/Wan_2.2_ComfyUI_Repackaged/resolve/main/split_files/vae/wan2.2_vae.safetensors"
      }
    ]
  },
  "workflow": {
    "37": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
        "weight_dtype": "default"
      },
      "_meta": { "title": "Diffusion Model" }
    },
    "38": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "type": "wan",
        "device": "default"
      },
      "_meta": { "title": "Text Encoder" }
    },
    "39": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "wan2.2_vae.safetensors"
      },
      "_meta": { "title": "VAE" }
    },
    "48": {
      "class_type": "ModelSamplingSD3",
      "inputs": {
        "model": ["37", 0],
        "shift": 8
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["38", 0],
        "text": ""
      },
      "_meta": { "title": "Positive Prompt" }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["38", 0],
        "text": ""
      },
      "_meta": { "title": "Negative Prompt" }
    },
    "55": {
      "class_type": "Wan22ImageToVideoLatent",
      "inputs": {
        "vae": ["39", 0],
        "width": 1280,
        "height": 704,
        "length": 49,
        "batch_size": 1
      },
      "_meta": { "title": "Video Latent" }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["48", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["55", 0],
        "seed": 0,
        "steps": 20,
        "cfg": 5,
        "sampler_name": "uni_pc",
        "scheduler": "simple",
        "denoise": 1
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["3", 0],
        "vae": ["39", 0]
      }
    },
    "57": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": ["8", 0],
        "fps": 24
      }
    },
    "58": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": ["57", 0],
        "filename_prefix": "codecomfy/video",
        "format": "auto",
        "codec": "auto"
      }
    }
  }
}
